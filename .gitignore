# Machine-specific root overrides; roots.example.json is the committed template and
# `python scripts/roots.py` reports what discovery found without any of this.
roots.json

__pycache__/
*.pyc
.vs/

# Note: ghidra/bicelib_findings.json is generated from project.json by buildFindings.py, and
# is deliberately NOT ignored here - it is already tracked, so an ignore rule would have no
# effect and would only suggest otherwise. Whether a 6 MB generated file belongs in the
# repository is a separate question from this move, so it is left exactly as it was.
